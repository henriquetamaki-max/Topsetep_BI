# live-ingest — secrets esperadas em runtime
#
# Estas variaveis sao injetadas AUTOMATICAMENTE pela plataforma Supabase em
# producao. Listadas aqui apenas para visibilidade e para testes locais via
# `supabase functions serve --env-file`.
#
# NAO commitar um .env real com chaves reais (esta no .gitignore).

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
