# Edge Function stripe-webhook — secrets necessários.
#
# Para PRODUÇÃO: configure via `supabase secrets set <NAME>=<VALUE>` (não usa este arquivo).
# Para TESTE LOCAL: copie para `.env` (gitignored) e ajuste para valores test mode.

# Stripe — obtidos no Stripe Dashboard.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_BASIC=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PRO=price_xxxxxxxxxxxxxxxxxxxxxxxx

# Supabase — em produção são injetados automaticamente pelo runtime das Edge Functions.
# Em teste local com `supabase functions serve`, preencha com os valores do projeto local.
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJ...service-role...
