{
  "manifest_version": 3,
  "name": "BI TopStep — Live Monitor",
  "version": "0.1.0",
  "description": "Live monitor TopstepX → envia snapshots de posição e PnL para o BI TopStep (multi-tenant via Supabase JWT).",

  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "notifications"
  ],

  "host_permissions": [
    "https://topstepx.com/*",
    "https://*.supabase.co/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://topstepx.com/*"],
      "js": ["config.js", "content.js"],
      "run_at": "document_end"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "BI TopStep — Live Monitor",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "web_accessible_resources": [
    {
      "resources": ["selectors.json", "config.js"],
      "matches": ["https://topstepx.com/*"]
    }
  ]
}
